# ============================================================
#  face_match — environment configuration
#  Copy this file to ".env" and fill in the blanks.
#  (.env is gitignored — never commit real secrets.)
# ============================================================

# --- SerpAPI: genuine reverse-image search (Google Lens) ---
# Free key (~100 searches/mo): https://serpapi.com/manage-api-key
SERPAPI_KEY=

# --- Wallet: Polygon Amoy TESTNET only ---
# A throwaway 0x-prefixed private key. Generate one with:
#     python scripts/new_wallet.py
# NEVER paste a real / mainnet key here.
PRIVATE_KEY=

# --- Deployed contract address (auto-filled by scripts/deploy_contract.py) ---
CONTRACT_ADDRESS=

# --- Network (defaults below are correct for Polygon Amoy) ---
RPC_URL=https://rpc-amoy.polygon.technology
CHAIN_ID=80002
EXPLORER_BASE=https://amoy.polygonscan.com
